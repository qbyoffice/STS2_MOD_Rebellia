  <Target Name="GetGitVersion" BeforeTargets="GenerateVersionedManifest">
    <Exec
      Command="git describe --tags --abbrev=0"
      ConsoleToMSBuild="true"
      StandardOutputImportance="high"
      IgnoreExitCode="true"
    >
      <Output TaskParameter="ConsoleOutput" PropertyName="GitTagRaw" />
      <Output TaskParameter="ExitCode" PropertyName="GitExitCode" />
    </Exec>

    <Message Text="Git exit code: $(GitExitCode)" Importance="High" />
    <Message Text="Git raw output: '$(GitTagRaw)'" Importance="High" />

    <PropertyGroup Condition="'$(GitExitCode)' != '0' Or '$(GitTagRaw)' == ''">
      <GitTagRaw>0.0.0</GitTagRaw>
    </PropertyGroup>

    <PropertyGroup>
      <GitVersion>$([System.Text.RegularExpressions.Regex]::Replace($(GitTagRaw.Trim()), '^v', ''))</GitVersion>
    </PropertyGroup>

    <PropertyGroup>
      <JsonVersion>v$(GitVersion)</JsonVersion>
    </PropertyGroup>

    <Message Text="Extracted version: $(GitVersion)" Importance="High" />
    <Message Text="JSON version: $(JsonVersion)" Importance="High" />

    <PropertyGroup>
      <Version>$(GitVersion)</Version>
      <FileVersion>$(GitVersion)</FileVersion>
    </PropertyGroup>
  </Target>

  <Target
    Name="GenerateVersionedManifest"
    BeforeTargets="BeforeBuild"
    DependsOnTargets="GetGitVersion"
  >
    <PropertyGroup>
      <GeneratedJsonPath>$(OutputPath)Rebellia.json</GeneratedJsonPath>
    </PropertyGroup>

    <GenerateJsonWithVersion
      SourceFile="Rebellia.json"
      DestFile="$(GeneratedJsonPath)"
      NewVersion="$(JsonVersion)"
    />
  </Target>

  <UsingTask
    TaskName="GenerateJsonWithVersion"
    TaskFactory="RoslynCodeTaskFactory"
    AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll"
  >
    <ParameterGroup>
      <SourceFile ParameterType="System.String" Required="true" />
      <DestFile ParameterType="System.String" Required="true" />
      <NewVersion ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
      try
      {
          string destDir = Path.GetDirectoryName(DestFile);
          if (!Directory.Exists(destDir))
              Directory.CreateDirectory(destDir);

          string content = File.ReadAllText(SourceFile, Encoding.UTF8);
          string oldPattern = "\"version\": \"VERSION_PLACEHOLDER\"";
          string newVersionLine = $"\"version\": \"{NewVersion}\"";
          string newContent = content.Replace(oldPattern, newVersionLine);

          File.WriteAllText(DestFile, newContent, Encoding.UTF8);
          Log.LogMessage(MessageImportance.High, $"Generated {DestFile} with version {NewVersion}");
      }
      catch (System.Exception ex)
      {
          Log.LogError($"Failed to generate versioned JSON: {ex.Message}");
          return false;
      }
      return true;
      ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="CopyToModsFolderOnBuild" AfterTargets="PostBuildEvent">
    <Message Text="Copying .dll and manifest to mods folder." Importance="high" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModsPath)$(MSBuildProjectName)/" />

    <Copy
      SourceFiles="$(OutputPath)Rebellia.json"
      DestinationFolder="$(ModsPath)$(MSBuildProjectName)/"
    />

    <Message Text="Copying BaseLib to mods folder." Importance="high" />
    <ItemGroup>
      <BaseLibFiles Include="packages/alchyr.sts2.baselib/**/lib/**/BaseLib.dll;packages/alchyr.sts2.baselib/**/Content/BaseLib.pck;packages/alchyr.sts2.baselib/**/Content/BaseLib.json;" />
    </ItemGroup>
    <Copy SourceFiles="@(BaseLibFiles)" DestinationFolder="$(ModsPath)BaseLib/" />
    <Copy
      Condition="'$(DebugMode)' == 'true'"
      SourceFiles="$(TargetDir)$(TargetName).pdb"
      DestinationFolder="$(ModsPath)$(MSBuildProjectName)/"
    />
  </Target>

  <Target
    Name="GodotPublish"
    AfterTargets="Publish"
    Condition="'$(GodotPath)' != '' and Exists('$(GodotPath)') and '$(IsInnerGodotExport)' != 'true'"
  >
    <Message Text="Exporting Godot .pck to mods folder" Importance="high" />
    <Exec
      Command="&quot;$(GodotPath)&quot; --headless --no-csharp-build --export-pack &quot;BasicExport&quot; &quot;$(ModsPath)$(MSBuildProjectName)/$(MSBuildProjectName).pck&quot;"
      EnvironmentVariables="IsInnerGodotExport=true;MSBUILDDISABLENODEREUSE=1"
      ContinueOnError="WarnAndContinue"
    />
  </Target>

  <Target
    Name="GodotPublishSkipped"
    AfterTargets="Publish"
    Condition="'$(GodotPath)' == '' or !Exists('$(GodotPath)')"
  >
    <Message
      Text="Skipping Godot .pck export because GodotPath is not configured."
      Importance="high"
    />
  </Target>
